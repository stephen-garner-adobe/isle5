          }
        ]
      },
      {
        "component": "number",
        "valueType": "number",
        "name": "searchRadius",
        "label": "Search Radius",
        "description": "Initial distance cap. Zero means all distances.",
        "value": 0,
        "required": false,
        "validation": {
          "numberMin": 0,
          "numberMax": 100
        }
      },
      {
        "component": "number",
        "valueType": "number",
        "name": "maxResults",
        "label": "Maximum Results",
        "description": "Maximum number of stores rendered.",
        "value": 10,
        "required": false,
        "validation": {
          "numberMin": 1,
          "numberMax": 50
        }
      },
      {
        "component": "boolean",
        "valueType": "boolean",
        "name": "autoDetectLocation",
        "label": "Auto-Detect Location",
        "description": "Request shopper geolocation when the block initializes.",
        "value": true,
        "required": false
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "defaultLocation",
        "label": "Default Location",
        "description": "Location used when shopper geolocation is unavailable.",
        "value": "Portland, OR",
        "required": false
      },
      {
        "component": "multiselect",
        "valueType": "string",
        "name": "servicesFilter",
        "label": "Available Service Filters",
        "description": "Services shoppers can use to filter stores.",
        "value": [
          "pharmacy",
          "pickup",
          "delivery",
          "24-hour",
          "deli",
          "bakery"
        ],
        "required": false,
        "options": [
          {
            "name": "Pharmacy",
            "value": "pharmacy"
          },
          {
            "name": "Pickup",
            "value": "pickup"
          },
          {
            "name": "Delivery",
            "value": "delivery"
          },
          {
            "name": "24 Hour",
            "value": "24-hour"
          },
          {
            "name": "Deli",
            "value": "deli"
          },
          {
            "name": "Bakery",
            "value": "bakery"
          },
          {
            "name": "Organic",
            "value": "organic"
          },
          {
            "name": "Gas Station",
            "value": "gas-station"
          }
        ]
      },
      {
        "component": "select",
        "valueType": "string",
        "name": "experienceMode",
        "label": "Experience Mode",
        "description": "Fast uses lighter Places payloads; rich enables photos and reviews.",
        "value": "fast",
        "required": false,
        "options": [
          {
            "name": "Fast",
            "value": "fast"
          },
          {
            "name": "Rich",
            "value": "rich"
          }
        ]
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "radiusPresets",
