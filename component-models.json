        "component": "select",
        "valueType": "string",
        "name": "units",
        "label": "Distance Units",
        "description": "Unit used for radius filtering and displayed distances.",
        "value": "miles",
        "required": false,
        "options": [
          {
            "name": "Miles",
            "value": "miles"
          },
          {
            "name": "Kilometers",
            "value": "km"
          }
        ]
      },
      {
        "component": "text",
        "valueType": "string",
        "name": "noResultsMessage",
