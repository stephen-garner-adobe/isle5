{
  "definitions": [
    {
      "title": "Store Locator",
      "id": "store-locator",
      "model": "store-locator",
      "plugins": {
        "da": {
          "name": "store-locator",
          "type": "key-value-block"
        }
      }
    }
  ],
  "models": [
    {
      "id": "store-locator",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "googleMapsApiKey",
          "label": "Google Maps API Key",
          "description": "Browser-delivered Maps key. Use an HTTP-referrer-restricted key only.",
          "value": "",
          "required": false
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "defaultView",
          "label": "Default View",
          "description": "Initial store locator layout.",
          "value": "split",
          "required": false,
          "options": [
            {
              "name": "Split",
              "value": "split"
            },
            {
              "name": "Map",
              "value": "map"
            },
            {
              "name": "List",
              "value": "list"
            }
          ]
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "searchRadius",
          "label": "Search Radius",
          "description": "Initial distance cap. Zero means all distances.",
          "value": 0,
          "required": false,
          "validation": {
            "numberMin": 0,
            "numberMax": 100
          }
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "maxResults",
          "label": "Maximum Results",
          "description": "Maximum number of stores rendered.",
          "value": 10,
          "required": false,
          "validation": {
            "numberMin": 1,
            "numberMax": 50
          }
        },
        {
          "component": "boolean",
          "valueType": "boolean",
          "name": "autoDetectLocation",
          "label": "Auto-Detect Location",
          "description": "Request shopper geolocation when the block initializes.",
          "value": true,
          "required": false
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "defaultLocation",
          "label": "Default Location",
          "description": "Location used when shopper geolocation is unavailable.",
          "value": "Portland, OR",
          "required": false
        },
        {
          "component": "multiselect",
          "valueType": "string",
          "name": "servicesFilter",
          "label": "Available Service Filters",
          "description": "Services shoppers can use to filter stores.",
          "value": [
            "pharmacy",
            "pickup",
            "delivery",
            "24-hour",
            "deli",
            "bakery"
          ],
          "required": false,
          "options": [
            {
              "name": "Pharmacy",
              "value": "pharmacy"
            },
            {
              "name": "Pickup",
              "value": "pickup"
            },
            {
              "name": "Delivery",
              "value": "delivery"
            },
            {
              "name": "24 Hour",
              "value": "24-hour"
            },
            {
              "name": "Deli",
              "value": "deli"
            },
            {
              "name": "Bakery",
              "value": "bakery"
            },
            {
              "name": "Organic",
              "value": "organic"
            },
            {
              "name": "Gas Station",
              "value": "gas-station"
            }
          ]
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "experienceMode",
          "label": "Experience Mode",
          "description": "Fast uses lighter Places payloads; rich enables photos and reviews.",
          "value": "fast",
          "required": false,
          "options": [
            {
              "name": "Fast",
              "value": "fast"
            },
            {
              "name": "Rich",
              "value": "rich"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "radiusPresets",
          "label": "Radius Presets",
          "description": "Comma-separated radius options shown to shoppers.",
          "value": "0,5,10,25,50",
          "required": false
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "units",
          "label": "Distance Units",
          "description": "Unit used for radius filtering and displayed distances.",
          "value": "miles",
          "required": false,
          "options": [
            {
              "name": "Miles",
              "value": "miles"
            },
            {
              "name": "Kilometers",
              "value": "km"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "noResultsMessage",
          "label": "No Results Message",
          "description": "Message shown when no stores match the active filters.",
          "value": "No stores found matching your criteria. Please try a different search or remove some filters.",
          "required": false
        },
        {
          "component": "number",
          "valueType": "number",
          "name": "maxReviewsPerStore",
          "label": "Maximum Reviews Per Store",
          "description": "Maximum review count rendered in rich mode.",
          "value": 5,
          "required": false,
          "validation": {
            "numberMin": 1,
            "numberMax": 20
          }
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "mapStyle",
          "label": "Map Style",
          "description": "Visual treatment for a configured Google map ID.",
          "value": "default",
          "required": false,
          "options": [
            {
              "name": "Default",
              "value": "default"
            },
            {
              "name": "Muted",
              "value": "muted"
            },
            {
              "name": "Minimal",
              "value": "minimal"
            }
          ]
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "primaryCtaLabel",
          "label": "Primary CTA Label",
          "description": "Label used for directions actions.",
          "value": "Get Directions",
          "required": false
        },
        {
          "component": "select",
          "valueType": "string",
          "name": "storeCardDensity",
          "label": "Store Card Density",
          "description": "Spacing density used by store cards.",
          "value": "comfortable",
          "required": false,
          "options": [
            {
              "name": "Comfortable",
              "value": "comfortable"
            },
            {
              "name": "Compact",
              "value": "compact"
            }
          ]
        }
      ]
    }
  ],
  "filters": []
}
